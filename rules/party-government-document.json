{
  "format": "wps-text-proofreading-rules",
  "version": 1,
  "name": "党政机关公文规则",
  "packVersion": "2026.09.26",
  "description": "依据现行党政机关公文处理与格式规范整理的低误报规则。涉及行文关系、文种选择等语义判断的事项默认只提醒。",
  "sources": [
    {
      "title": "GB/T 9704—2012 党政机关公文格式",
      "authority": "国家标准（现行）",
      "url": "https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=71F772D7E77CD3A7E05397BE0A0AB82A"
    },
    {
      "title": "党政机关公文处理工作条例",
      "authority": "中共中央办公厅、国务院办公厅",
      "url": "https://www.gov.cn/zhengce/2013-02/22/content_2640088.htm"
    }
  ],
  "rules": [
    {
      "id": "gov-heading-second-ascii-parens",
      "name": "二级标题使用全角括号",
      "enabled": true,
      "group": "结构层次",
      "type": "regex",
      "pattern": "^\\(([一二三四五六七八九十百]+)\\)",
      "flags": "m",
      "replacement": "（$1）",
      "severity": "medium",
      "autoFix": true,
      "priority": 110,
      "source": "GB/T 9704—2012",
      "notes": "正文结构层次通常依次使用“一、”“（一）”“1.”“（1）”；本规则仅处理行首中文序号的半角括号。"
    },
    {
      "id": "gov-heading-third-cn-comma",
      "name": "三级标题序号用点号提醒",
      "enabled": true,
      "group": "结构层次",
      "type": "regex",
      "pattern": "^([0-9]+)、",
      "flags": "m",
      "replacement": "$1.",
      "severity": "medium",
      "autoFix": false,
      "priority": 80,
      "source": "GB/T 9704—2012",
      "notes": "若该行属于第三级结构层次，通常使用“1.”形式；因普通列表也可能使用“1、”，默认人工确认。"
    },
    {
      "id": "gov-heading-fourth-ascii-parens",
      "name": "四级标题使用全角括号",
      "enabled": true,
      "group": "结构层次",
      "type": "regex",
      "pattern": "^\\(([0-9]+)\\)",
      "flags": "m",
      "replacement": "（$1）",
      "severity": "medium",
      "autoFix": true,
      "priority": 105,
      "source": "GB/T 9704—2012",
      "notes": "第四级结构层次通常使用“（1）”形式。"
    },
    {
      "id": "gov-doc-number-square-brackets",
      "name": "发文字号年份使用六角括号",
      "enabled": true,
      "group": "发文字号",
      "type": "regex",
      "pattern": "([\\u4e00-\\u9fff]{1,12})\\[(20\\d{2})\\](\\d+)号",
      "flags": "",
      "replacement": "$1〔$2〕$3号",
      "severity": "high",
      "autoFix": true,
      "priority": 130,
      "source": "GB/T 9704—2012 7.2.5",
      "notes": "发文字号年份应标全称，并使用六角括号“〔〕”括入。"
    },
    {
      "id": "gov-doc-number-leading-zero",
      "name": "发文顺序号不编虚位",
      "enabled": true,
      "group": "发文字号",
      "type": "regex",
      "pattern": "〔(20\\d{2})〕0+([1-9]\\d*)号",
      "flags": "",
      "replacement": "〔$1〕$2号",
      "severity": "high",
      "autoFix": true,
      "priority": 130,
      "source": "GB/T 9704—2012 7.2.5",
      "notes": "发文顺序号不编虚位，例如1不编为01。"
    },
    {
      "id": "gov-doc-number-di",
      "name": "发文顺序号不加“第”字",
      "enabled": true,
      "group": "发文字号",
      "type": "regex",
      "pattern": "〔(20\\d{2})〕第(\\d+)号",
      "flags": "",
      "replacement": "〔$1〕$2号",
      "severity": "high",
      "autoFix": true,
      "priority": 130,
      "source": "GB/T 9704—2012 7.2.5",
      "notes": "发文顺序号不加“第”字。"
    },
    {
      "id": "gov-signer-colon",
      "name": "“签发人”后使用全角冒号",
      "enabled": true,
      "group": "版头要素",
      "type": "replace",
      "pattern": "签发人:",
      "replacement": "签发人：",
      "severity": "medium",
      "autoFix": true,
      "priority": 100,
      "source": "GB/T 9704—2012 7.2.6",
      "notes": "“签发人”三字后使用全角冒号。"
    },
    {
      "id": "gov-attachment-colon",
      "name": "“附件”后使用全角冒号",
      "enabled": true,
      "group": "附件与正文",
      "type": "replace",
      "pattern": "附件:",
      "replacement": "附件：",
      "severity": "medium",
      "autoFix": true,
      "priority": 100,
      "source": "GB/T 9704—2012",
      "notes": "附件说明中的“附件”后使用全角冒号。"
    },
    {
      "id": "gov-report-with-request",
      "name": "报告中夹带请示事项提醒",
      "enabled": true,
      "group": "文种与行文",
      "type": "reminder",
      "pattern": "妥否，请批示",
      "replacement": "",
      "severity": "high",
      "autoFix": false,
      "priority": 90,
      "source": "《党政机关公文处理工作条例》第十五条",
      "notes": "条例规定，请示应当一文一事，不得在报告等非请示性公文中夹带请示事项。若当前文种为报告，应重点复核。"
    },
    {
      "id": "gov-request-one-item",
      "name": "请示“一文一事”提醒",
      "enabled": true,
      "group": "文种与行文",
      "type": "reminder",
      "pattern": "请示如下",
      "replacement": "",
      "severity": "medium",
      "autoFix": false,
      "priority": 40,
      "source": "《党政机关公文处理工作条例》第十五条",
      "notes": "请示应当一文一事。本规则仅提示核对，不判断文中是否实际包含多个事项。"
    },
    {
      "id": "gov-short-name-first-use",
      "name": "简称首次出现核对提醒",
      "enabled": false,
      "group": "名称与引用",
      "type": "reminder",
      "pattern": "以下简称",
      "replacement": "",
      "severity": "low",
      "autoFix": false,
      "priority": 30,
      "source": "公文规范用语",
      "notes": "简称首次出现应核对全称和简称关系；当前纯文本规则无法判断是否为首次出现，默认停用。"
    },
    {
      "id": "gov-title-punctuation",
      "name": "公文标题标点提醒",
      "enabled": false,
      "group": "标题",
      "type": "reminder",
      "pattern": "关于",
      "replacement": "",
      "severity": "low",
      "autoFix": false,
      "priority": 10,
      "source": "GB/T 9704—2012及公文处理规范",
      "notes": "标题一般不用标点，但仅凭“关于”等关键词无法可靠识别标题区域，因此默认停用；后续接入样式/段落位置识别后再增强。"
    }
  ]
}
