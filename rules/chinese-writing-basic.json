{
  "format": "wps-text-proofreading-rules",
  "version": 1,
  "name": "中文及公文基础规范",
  "packVersion": "2026.09.26",
  "description": "低误报的中文正式文稿基础规则。确定性格式问题可自动修正，语义性问题仅提醒。",
  "sources": [
    {
      "title": "GB/T 15834 标点符号用法",
      "authority": "国家标准",
      "note": "GB/T 9704—2012 将其列为规范性引用文件"
    },
    {
      "title": "GB/T 15835 出版物上数字用法",
      "authority": "国家标准",
      "note": "GB/T 9704—2012 将其列为规范性引用文件"
    },
    {
      "title": "GB/T 9704—2012 党政机关公文格式",
      "authority": "国家标准",
      "url": "https://std.samr.gov.cn/gb/search/gbDetailedCNF?id=71F772D7E77CD3A7E05397BE0A0AB82A"
    }
  ],
  "rules": [
    {
      "id": "basic-space-before-cn-punct",
      "name": "删除中文标点前多余空格",
      "enabled": true,
      "group": "标点与空格",
      "type": "regex",
      "pattern": "[ \\t]+([，。；：！？])",
      "flags": "",
      "replacement": "$1",
      "severity": "low",
      "autoFix": true,
      "priority": 100,
      "source": "中文标点规范",
      "notes": "中文正文中，逗号、句号、分号、冒号、问号、叹号前不应留空格。"
    },
    {
      "id": "basic-duplicate-comma",
      "name": "连续中文逗号",
      "enabled": true,
      "group": "标点与空格",
      "type": "regex",
      "pattern": "，{2,}",
      "flags": "",
      "replacement": "，",
      "severity": "low",
      "autoFix": true,
      "priority": 100,
      "source": "中文标点规范",
      "notes": "连续重复逗号通常属于录入错误。"
    },
    {
      "id": "basic-duplicate-period",
      "name": "连续中文句号",
      "enabled": true,
      "group": "标点与空格",
      "type": "regex",
      "pattern": "。{2,}",
      "flags": "",
      "replacement": "。",
      "severity": "low",
      "autoFix": true,
      "priority": 100,
      "source": "中文标点规范",
      "notes": "连续重复句号通常属于录入错误；省略号应使用规范省略号，不用多个句号代替。"
    },
    {
      "id": "basic-duplicate-semicolon",
      "name": "连续中文分号",
      "enabled": true,
      "group": "标点与空格",
      "type": "regex",
      "pattern": "；{2,}",
      "flags": "",
      "replacement": "；",
      "severity": "low",
      "autoFix": true,
      "priority": 100,
      "source": "中文标点规范",
      "notes": "连续重复分号通常属于录入错误。"
    },
    {
      "id": "basic-ascii-comma-between-hanzi",
      "name": "汉字之间误用英文逗号",
      "enabled": true,
      "group": "标点与空格",
      "type": "regex",
      "pattern": "([\\u4e00-\\u9fff]),([\\u4e00-\\u9fff])",
      "flags": "",
      "replacement": "$1，$2",
      "severity": "low",
      "autoFix": true,
      "priority": 90,
      "source": "中文标点规范",
      "notes": "中文句子中汉字之间的普通逗号通常应使用全角中文逗号。"
    },
    {
      "id": "basic-ascii-colon-between-hanzi",
      "name": "汉字之间误用英文冒号",
      "enabled": true,
      "group": "标点与空格",
      "type": "regex",
      "pattern": "([\\u4e00-\\u9fff]):([\\u4e00-\\u9fff])",
      "flags": "",
      "replacement": "$1：$2",
      "severity": "low",
      "autoFix": true,
      "priority": 90,
      "source": "中文标点规范",
      "notes": "中文正文中汉字之间的冒号通常应使用中文全角冒号。"
    },
    {
      "id": "basic-date-hao-to-ri",
      "name": "正式日期中的“号”改“日”",
      "enabled": true,
      "group": "日期与数字",
      "type": "regex",
      "pattern": "(\\d{1,2})月(\\d{1,2})号",
      "flags": "",
      "replacement": "$1月$2日",
      "severity": "medium",
      "autoFix": true,
      "priority": 95,
      "source": "正式文稿日期规范",
      "notes": "正式公文日期一般写“月、日”，避免口语化“号”；规则仅匹配“X月X号”，避免误伤“3号线”等。"
    },
    {
      "id": "basic-jiezhi-muqian",
      "name": "“截止目前”规范为“截至目前”",
      "enabled": true,
      "group": "常见用词",
      "type": "replace",
      "pattern": "截止目前",
      "replacement": "截至目前",
      "severity": "medium",
      "autoFix": true,
      "priority": 95,
      "source": "现代汉语时间介词用法",
      "notes": "表示时间界限到当前时点时，一般使用“截至目前”。"
    },
    {
      "id": "basic-jiezhi-time",
      "name": "“截止到目前”规范提醒",
      "enabled": true,
      "group": "常见用词",
      "type": "replace",
      "pattern": "截止到目前",
      "replacement": "截至目前",
      "severity": "low",
      "autoFix": false,
      "priority": 70,
      "source": "正式文稿用语",
      "notes": "正式文稿通常可简化为“截至目前”，但应结合句意人工确认。"
    },
    {
      "id": "basic-heading-cn-dot",
      "name": "一级序号误用英文点号",
      "enabled": true,
      "group": "层次序号",
      "type": "regex",
      "pattern": "^([一二三四五六七八九十百]+)\\.",
      "flags": "m",
      "replacement": "$1、",
      "severity": "medium",
      "autoFix": false,
      "priority": 70,
      "source": "公文结构层次惯例",
      "notes": "若该行确属一级层次标题，通常使用“一、”形式；因正文中也可能出现特殊编号，默认人工确认。"
    },
    {
      "id": "basic-fullwidth-percent",
      "name": "全角百分号提醒",
      "enabled": true,
      "group": "日期与数字",
      "type": "reminder",
      "pattern": "％",
      "flags": "",
      "replacement": "%",
      "severity": "low",
      "autoFix": false,
      "priority": 40,
      "source": "数字与符号规范",
      "notes": "不同单位对百分号全角/半角可能有版式要求；仅提醒核对并统一，不自动修改。"
    }
  ]
}
